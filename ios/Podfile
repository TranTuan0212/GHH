platform :ios, '16.0'
use_frameworks! :linkage => :static

target 'SloMoLive' do
  # RTMP push từ iOS lên Node Media Server (NMS).
  # LFLiveKit đã được dùng trong CameraManager.swift để đẩy luồng H.264 120/240fps.
  pod 'LFLiveKit'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      # Cho phép build không cần code-signing trên Codemagic CI
      config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ''
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
    end

    # LFLiveKit enables B-frame reordering by default. At 120/240fps its RTMP publisher
    # can emit non-monotonic DTS, which makes the server-side 60fps decoder stall. For this
    # low-latency DVR pipeline, encode in display order (no B-frames) so PTS/DTS are monotonic.
    if target.name == 'LFLiveKit'
      encoder = File.join(target.project.path.dirname, 'LFLiveKit', 'LFLiveKit', 'coder', 'LFHardwareVideoEncoder.m')
      if File.exist?(encoder)
        source = File.read(encoder)
        patched = source.gsub(
          'kVTCompressionPropertyKey_AllowFrameReordering, kCFBooleanTrue',
          'kVTCompressionPropertyKey_AllowFrameReordering, kCFBooleanFalse'
        ).gsub(
          'kVTProfileLevel_H264_Main_AutoLevel',
          'kVTProfileLevel_H264_High_AutoLevel'
        )
        File.write(encoder, patched) if patched != source
      end

      # Prevent LFLiveVideoConfiguration from creating a dummy AVCaptureSession attached to
      # AVCaptureDevicePositionFront, which resets the front camera's activeFormat (1080p 120fps)
      # back to 720p 30fps whenever defaultConfiguration is called.
      video_cfg = File.join(target.project.path.dirname, 'LFLiveKit', 'LFLiveKit', 'configuration', 'LFLiveVideoConfiguration.m')
      if File.exist?(video_cfg)
        cfg_source = File.read(video_cfg)
        cfg_patched = cfg_source.gsub(
          "- (LFLiveVideoSessionPreset)supportSessionPreset:(LFLiveVideoSessionPreset)sessionPreset {",
          "- (LFLiveVideoSessionPreset)supportSessionPreset:(LFLiveVideoSessionPreset)sessionPreset {\n    return sessionPreset;"
        )
        File.write(video_cfg, cfg_patched) if cfg_patched != cfg_source
      end

      # Prevent LFStreamingBuffer from prematurely deleting unsent P/I frames during brief
      # network jitter at 120fps (600 frames = only 5s at 120fps). Increase max unsent buffer
      # to 3600 frames (30s at 120fps); once a frame is sent to the server, popFirstObject
      # immediately removes it from RAM as usual.
      streaming_buf = File.join(target.project.path.dirname, 'LFLiveKit', 'LFLiveKit', 'buffer', 'LFStreamingBuffer.m')
      if File.exist?(streaming_buf)
        buf_source = File.read(streaming_buf)
        buf_patched = buf_source.gsub(
          'defaultSendBufferMaxCount = 600;',
          'defaultSendBufferMaxCount = 3600;'
        ).gsub(
          'defaultSortBufferMaxCount = 5;',
          'defaultSortBufferMaxCount = 2;'
        )
        File.write(streaming_buf, buf_patched) if buf_patched != buf_source
      end
    end
  end
end
